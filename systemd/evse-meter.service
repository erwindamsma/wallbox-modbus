[Unit]
Description=EV charger energy meter emulator (INEPRO N1-CT over Modbus RTU)
Documentation=https://github.com/erwindamsma/wallbox-modbus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The user must be in the dialout group to reach /dev/ttyUSB*.
User=wallbox
SupplementaryGroups=dialout
WorkingDirectory=/opt/wallbox-modbus
ExecStart=/opt/wallbox-modbus/.venv/bin/python -m evse_meter -c /etc/evse-meter/config.yaml
Restart=always
RestartSec=5

# Creates and owns /var/lib/evse-meter for the energy counters.
StateDirectory=evse-meter

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
